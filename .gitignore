# Virtual Environment
.venv/
venv/
ENV/
.tools/
cache/

# Downloaded and derived geospatial data must never be committed.
data/raw/*
!data/raw/README.md
data/processed/*
!data/processed/.gitkeep
outputs/maps/*
!outputs/maps/.gitkeep

# Python cache and temporary files
__pycache__/
*.py[cod]
*$py.class
*.grib
*.grib.*.idx

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# IDE configurations
.vscode/
.idea/

# OS-generated files
Thumbs.db
Desktop.ini
